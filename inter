<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Excel Avanzado: Fórmulas Condicionales</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- React & Babel CDNs -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <!-- html2canvas for certificate export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
</head>
<body class="bg-gray-100 font-sans antialiased text-gray-800">
    
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        const courseData = [
          {
            id: "cond-1",
            level: "Nivel 2: Fórmulas Condicionales",
            title: "1. La Función CONTAR.SI",
            theory: [
              { type: 'p', content: 'La función <strong>CONTAR.SI</strong> cuenta el número de celdas en un rango que cumplen con un criterio específico (una condición).' },
              { type: 'highlight', content: 'REGLA: Los criterios de texto o los símbolos matemáticos (>, <) SIEMPRE deben ir entre comillas (" ").' },
              { type: 'h3', content: 'Sintaxis de CONTAR.SI' },
              { type: 'code', content: '=CONTAR.SI(rango; "criterio")' },
              { type: 'ul', items: [
                '<strong>Rango:</strong> Las celdas que queremos revisar.',
                '<strong>Criterio:</strong> Lo que estamos buscando (Ej. "Aprobado", ">50", "Juan").'
              ]},
              { type: 'example', title: 'Ejemplo:', code: '=CONTAR.SI(B2:B10; "Juan")', desc: 'Cuenta cuántas veces aparece la palabra "Juan" en el rango B2 a B10.' }
            ],
            exercises: [
              {
                instruction: "Ejercicio 1: Calcula cuántas veces aparece el vendedor 'Juan'. Usa la función CONTAR.SI en el rango A2:A5.",
                grid: [
                  { row: 1, cols: ["Vendedor", "Ventas", "", "Recuento de Juan"] },
                  { row: 2, cols: ["Juan", "150", "", ""] },
                  { row: 3, cols: ["Ana", "200", "", ""] },
                  { row: 4, cols: ["Juan", "100", "", ""] },
                  { row: 5, cols: ["Pedro", "300", "", ""] }
                ],
                targetCell: "D2",
                validAnswers: ["=CONTAR.SI(A2:A5;\"JUAN\")"],
                resultValue: "2", 
                tip: "Escribe =CONTAR.SI(A2:A5; \"Juan\"). ¡No olvides las comillas!"
              },
              {
                instruction: "Ejercicio 2: Cuenta cuántos productos tienen un Stock mayor a 50. El rango es B2:B5 y el criterio es \">50\".",
                grid: [
                  { row: 1, cols: ["Producto", "Stock", "", "Stock Mayor a 50"] },
                  { row: 2, cols: ["Teclado", "20", "", ""] },
                  { row: 3, cols: ["Mouse", "80", "", ""] },
                  { row: 4, cols: ["Monitor", "15", "", ""] },
                  { row: 5, cols: ["Audífonos", "60", "", ""] }
                ],
                targetCell: "D2",
                validAnswers: ["=CONTAR.SI(B2:B5;\">50\")"],
                resultValue: "2", 
                tip: "El criterio debe ir entre comillas: =CONTAR.SI(B2:B5; \">50\")"
              }
            ]
          },
          {
            id: "cond-2",
            level: "Nivel 2: Fórmulas Condicionales",
            title: "2. La Función SUMAR.SI",
            theory: [
              { type: 'p', content: 'A diferencia de CONTAR.SI (que solo cuenta elementos), <strong>SUMAR.SI</strong> suma los valores de un rango siempre y cuando se cumpla una condición.' },
              { type: 'h3', content: 'Sintaxis de SUMAR.SI' },
              { type: 'code', content: '=SUMAR.SI(rango_criterio; "criterio"; [rango_suma])' },
              { type: 'p', content: 'El <strong>rango_suma</strong> es opcional. Si lo omites, Excel sumará los valores del primer rango. Lo usamos cuando la condición está en una columna, pero los números a sumar están en otra.' },
              { type: 'example', title: 'Ejemplo:', code: '=SUMAR.SI(A2:A5; "Norte"; B2:B5)', desc: 'Busca "Norte" en la columna A, y suma sus valores correspondientes en la columna B.' }
            ],
            exercises: [
              {
                instruction: "Ejercicio 1: Suma el total de Ventas únicamente de la zona 'Norte'. El rango a evaluar es A2:A5, y el rango a sumar es B2:B5.",
                grid: [
                  { row: 1, cols: ["Zona", "Ventas ($)", "", "Total Zona Norte"] },
                  { row: 2, cols: ["Norte", "500", "", ""] },
                  { row: 3, cols: ["Sur", "200", "", ""] },
                  { row: 4, cols: ["Norte", "300", "", ""] },
                  { row: 5, cols: ["Este", "100", "", ""] }
                ],
                targetCell: "D2",
                validAnswers: ["=SUMAR.SI(A2:A5;\"NORTE\";B2:B5)"],
                resultValue: "800", 
                tip: "Sigue la estructura: =SUMAR.SI(rango_zonas; \"Norte\"; rango_ventas)"
              },
              {
                instruction: "Ejercicio 2: Suma solo los Gastos que sean mayores a 100. Como el criterio y la suma están en la misma columna (B2:B5), no necesitas el tercer argumento.",
                grid: [
                  { row: 1, cols: ["Mes", "Gastos", "", "Gastos > 100"] },
                  { row: 2, cols: ["Ene", "50", "", ""] },
                  { row: 3, cols: ["Feb", "150", "", ""] },
                  { row: 4, cols: ["Mar", "80", "", ""] },
                  { row: 5, cols: ["Abr", "200", "", ""] }
                ],
                targetCell: "D2",
                validAnswers: [
                  "=SUMAR.SI(B2:B5;\">100\")", 
                  "=SUMAR.SI(B2:B5;\">100\";B2:B5)"
                ],
                resultValue: "350", 
                tip: "Escribe =SUMAR.SI(B2:B5; \">100\")"
              }
            ]
          },
          {
            id: "cond-3",
            level: "Nivel 2: Fórmulas Condicionales",
            title: "3. La Función PROMEDIO.SI",
            theory: [
              { type: 'p', content: 'La función <strong>PROMEDIO.SI</strong> calcula la media aritmética de un grupo de celdas, pero excluyendo las que no cumplan el criterio establecido.' },
              { type: 'h3', content: 'Sintaxis de PROMEDIO.SI' },
              { type: 'code', content: '=PROMEDIO.SI(rango_criterio; "criterio"; [rango_promedio])' },
              { type: 'example', title: 'Ejemplo:', code: '=PROMEDIO.SI(C2:C10; ">0")', desc: 'Promedia los números de C2 a C10, ignorando los ceros o números negativos.' }
            ],
            exercises: [
              {
                instruction: "Ejercicio 1: Calcula el Promedio de las calificaciones, pero SOLO de la materia 'Matemáticas'. Evalúa A2:A5 y promedia B2:B5.",
                grid: [
                  { row: 1, cols: ["Materia", "Nota", "", "Promedio Matemáticas"] },
                  { row: 2, cols: ["Matemáticas", "8", "", ""] },
                  { row: 3, cols: ["Historia", "9", "", ""] },
                  { row: 4, cols: ["Matemáticas", "10", "", ""] },
                  { row: 5, cols: ["Ciencias", "7", "", ""] }
                ],
                targetCell: "D2",
                validAnswers: ["=PROMEDIO.SI(A2:A5;\"MATEMÁTICAS\";B2:B5)", "=PROMEDIO.SI(A2:A5;\"MATEMATICAS\";B2:B5)"],
                resultValue: "9", 
                tip: "Escribe =PROMEDIO.SI(A2:A5; \"Matemáticas\"; B2:B5)"
              },
              {
                instruction: "Ejercicio 2: Calcula el Promedio de los Salarios mayores a 1000. Evalúa y promedia el rango B2:B5 con el criterio \">1000\".",
                grid: [
                  { row: 1, cols: ["Puesto", "Salario", "", "Promed. > 1000"] },
                  { row: 2, cols: ["Junior", "800", "", ""] },
                  { row: 3, cols: ["Senior", "2000", "", ""] },
                  { row: 4, cols: ["Junior", "900", "", ""] },
                  { row: 5, cols: ["Líder", "3000", "", ""] }
                ],
                targetCell: "D2",
                validAnswers: ["=PROMEDIO.SI(B2:B5;\">1000\")", "=PROMEDIO.SI(B2:B5;\">1000\";B2:B5)"],
                resultValue: "2500", 
                tip: "Usa =PROMEDIO.SI(B2:B5; \">1000\")"
              }
            ]
          },
          {
            id: "cond-4",
            level: "Nivel 2: Fórmulas Condicionales",
            title: "4. MAX.SI y MIN.SI",
            theory: [
              { type: 'p', content: 'En versiones modernas de Excel existen las funciones <strong>MAX.SI.CONJUNTO</strong> y <strong>MIN.SI.CONJUNTO</strong>. Estas obtienen el valor máximo o mínimo de un rango filtrando por condiciones.' },
              { type: 'highlight', content: '¡OJO CON EL ORDEN! A diferencia de SUMAR.SI, aquí el rango del resultado (los números) va PRIMERO.' },
              { type: 'h3', content: 'Sintaxis de MAX/MIN.SI.CONJUNTO' },
              { type: 'code', content: '=MAX.SI.CONJUNTO(rango_max; rango_criterio; "criterio")' },
              { type: 'ul', items: [
                '<strong>Rango_max:</strong> La columna con los números donde buscaremos el mayor.',
                '<strong>Rango_criterio:</strong> La columna donde buscaremos la condición.',
                '<strong>Criterio:</strong> La condición (Ej. "A").'
              ]},
              { type: 'example', title: 'Ejemplo:', code: '=MIN.SI.CONJUNTO(B2:B5; A2:A5; "Ropa")', desc: 'Busca el precio más bajo (B) únicamente en los productos de la categoría "Ropa" (A).' }
            ],
            exercises: [
              {
                instruction: "Ejercicio 1: Encuentra la Venta Máxima realizada por el equipo 'A'. El rango máximo es B2:B5 y el rango criterio es A2:A5.",
                grid: [
                  { row: 1, cols: ["Equipo", "Ventas", "", "Venta Máx Equipo A"] },
                  { row: 2, cols: ["A", "150", "", ""] },
                  { row: 3, cols: ["B", "300", "", ""] },
                  { row: 4, cols: ["A", "250", "", ""] },
                  { row: 5, cols: ["B", "100", "", ""] }
                ],
                targetCell: "D2",
                validAnswers: ["=MAX.SI.CONJUNTO(B2:B5;A2:A5;\"A\")"],
                resultValue: "250", 
                tip: "Recuerda: Rango de números primero. =MAX.SI.CONJUNTO(B2:B5; A2:A5; \"A\")"
              },
              {
                instruction: "Ejercicio 2: Encuentra la Temperatura Mínima registrada en el mes de 'Enero'. Rango mínimo: B2:B5. Rango criterio: A2:A5.",
                grid: [
                  { row: 1, cols: ["Mes", "Temp °C", "", "Mínima en Enero"] },
                  { row: 2, cols: ["Enero", "18", "", ""] },
                  { row: 3, cols: ["Febrero", "20", "", ""] },
                  { row: 4, cols: ["Enero", "14", "", ""] },
                  { row: 5, cols: ["Marzo", "22", "", ""] }
                ],
                targetCell: "D2",
                validAnswers: ["=MIN.SI.CONJUNTO(B2:B5;A2:A5;\"ENERO\")"],
                resultValue: "14", 
                tip: "Usa =MIN.SI.CONJUNTO(B2:B5; A2:A5; \"Enero\")"
              }
            ]
          }
        ];

        function App() {
          const [studentName, setStudentName] = useState("");
          const [instructorName, setInstructorName] = useState("Lic. Wilber López");
          const [hasStarted, setHasStarted] = useState(false);
          const [currentLessonIndex, setCurrentLessonIndex] = useState(0);
          const [currentExerciseIndex, setCurrentExerciseIndex] = useState(0); 
          const [viewMode, setViewMode] = useState('theory'); 
          const [userInput, setUserInput] = useState("");
          const [feedback, setFeedback] = useState(null);
          const [completedLessons, setCompletedLessons] = useState([]);
          const [showCompletionModal, setShowCompletionModal] = useState(false);
          const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false); 

          const lesson = courseData[currentLessonIndex];
          const exercise = lesson.exercises[currentExerciseIndex];
          const modules = [...new Set(courseData.map(l => l.level))];

          useEffect(() => {
            if (!document.getElementById('html2canvas-script')) {
              const script = document.createElement('script');
              script.id = 'html2canvas-script';
              script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
              script.async = true;
              document.head.appendChild(script);
            }
          }, []);

          const normalizeFormula = (formula) => {
            return formula
              .toUpperCase()
              .replace(/\s+/g, '')        
              .replace(/,/g, ';')         
              .replace(/'/g, '"');        
          };

          const handleCheck = () => {
            if (!userInput.trim()) {
              setFeedback('empty');
              return;
            }

            const normalizedInput = normalizeFormula(userInput);
            const isCorrect = exercise.validAnswers.some(ans => normalizeFormula(ans) === normalizedInput);

            if (isCorrect) {
              setFeedback('success');
              if (currentExerciseIndex === lesson.exercises.length - 1) {
                if (!completedLessons.includes(lesson.id)) {
                  const newCompleted = [...completedLessons, lesson.id];
                  setCompletedLessons(newCompleted);
                  if (newCompleted.length === courseData.length) {
                    setShowCompletionModal(true);
                  }
                }
              }
            } else {
              setFeedback('error');
            }
          };

          const handleNextExercise = () => {
            setUserInput("");
            setFeedback(null);
            setCurrentExerciseIndex(prev => prev + 1);
          };

          const handleNextLesson = () => {
            setUserInput("");
            setFeedback(null);
            setCurrentExerciseIndex(0);
            setViewMode('theory');
            if (currentLessonIndex < courseData.length - 1) {
              setCurrentLessonIndex(currentLessonIndex + 1);
            }
          };

          const goToLesson = (index) => {
            setCurrentLessonIndex(index);
            setCurrentExerciseIndex(0);
            setUserInput("");
            setFeedback(null);
            setViewMode('theory');
            setIsMobileMenuOpen(false); 
          };

          const getColumnLetter = (index) => String.fromCharCode(65 + index);

          const downloadCertificate = () => {
            const certElement = document.getElementById('certificate');
            if(certElement && window.html2canvas) {
                window.html2canvas(certElement, { scale: 2, useCORS: true }).then(canvas => {
                    const link = document.createElement('a');
                    link.download = `Certificado_Condicionales_${studentName.replace(/\s+/g, '_')}.png`;
                    link.href = canvas.toDataURL('image/png');
                    link.click();
                });
            } else {
                alert("La librería de descarga aún está cargando. Intenta en unos segundos.");
            }
          };

          const renderTheoryContent = () => {
            return lesson.theory.map((item, idx) => {
              switch (item.type) {
                case 'p':
                  return <p key={idx} className="text-gray-700 leading-relaxed mb-4 text-base md:text-lg" dangerouslySetInnerHTML={{__html: item.content}}></p>;
                case 'h3':
                  return <h3 key={idx} className="text-xl font-bold text-blue-800 mt-8 mb-3 border-b-2 border-blue-200 pb-2">{item.content}</h3>;
                case 'code':
                  return <div key={idx} className="bg-gray-800 text-blue-300 font-mono p-4 rounded-lg text-base md:text-lg mb-4 shadow-inner inline-block break-all border-l-4 border-blue-500">{item.content}</div>;
                case 'highlight':
                  return (
                    <div key={idx} className="bg-blue-50 border-l-4 border-blue-600 p-4 rounded-r-lg mb-6 shadow-sm">
                      <p className="text-blue-900 flex gap-3">
                        <i className="fas fa-lightbulb text-yellow-500 text-xl mt-1 flex-shrink-0"></i>
                        <span dangerouslySetInnerHTML={{__html: item.content}}></span>
                      </p>
                    </div>
                  );
                case 'ul':
                  return (
                    <ul key={idx} className="list-disc list-inside space-y-2 mb-6 text-gray-700 ml-2 md:ml-4">
                      {item.items.map((li, i) => <li key={i} dangerouslySetInnerHTML={{__html: li}}></li>)}
                    </ul>
                  );
                case 'example':
                  return (
                    <div key={idx} className="bg-white border border-gray-200 rounded-lg p-4 md:p-5 mb-6 shadow-sm overflow-hidden border-l-4 border-l-gray-400">
                      <p className="font-bold text-gray-800 mb-2">{item.title}</p>
                      <div className="bg-gray-100 font-mono text-gray-800 py-2 px-3 rounded border border-gray-300 mb-2 inline-block break-all text-sm md:text-base font-bold">
                        {item.code}
                      </div>
                      <p className="text-gray-600 text-sm mt-2">{item.desc}</p>
                    </div>
                  );
                default:
                  return null;
              }
            });
          };

          if (!hasStarted) {
            return (
              <div className="min-h-screen bg-blue-900 flex items-center justify-center p-4 font-sans relative overflow-hidden">
                <div className="absolute top-[-10%] left-[-10%] w-96 h-96 bg-blue-600 rounded-full mix-blend-multiply filter blur-[128px] opacity-40"></div>
                <div className="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-cyan-500 rounded-full mix-blend-multiply filter blur-[128px] opacity-30"></div>
                
                <div className="bg-white p-8 md:p-10 rounded-3xl max-w-md w-full shadow-2xl text-center relative z-10 border-t-8 border-blue-600">
                  <div className="w-20 h-20 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-4 border-4 border-blue-100 shadow-sm">
                    <i className="fas fa-file-excel text-blue-600 text-4xl"></i>
                  </div>
                  <h1 className="text-3xl font-extrabold text-gray-800 mb-1">Excel <span className="text-blue-600">Condicional</span></h1>
                  <p className="text-gray-500 mb-6 font-medium text-sm">Laboratorio Práctico de Fórmulas SI</p>
                  
                  <div className="text-left space-y-4 mb-6">
                    <div>
                      <label className="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" htmlFor="studentName">
                        <i className="fas fa-user-graduate text-blue-600 mr-1.5"></i> Nombre del Alumno:
                      </label>
                      <input
                        id="studentName"
                        type="text"
                        value={studentName}
                        onChange={(e) => setStudentName(e.target.value)}
                        placeholder="Ej. Juan Pérez"
                        className="w-full px-4 py-2.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-all text-base font-medium text-gray-800"
                        autoComplete="off"
                      />
                    </div>

                    <div>
                        <label className="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5" htmlFor="instructorName">
                            <i className="fas fa-chalkboard-teacher text-blue-600 mr-1.5"></i> Nombre del Instructor:
                        </label>
                    <input
                         id="instructorName"
                        type="text"
                          value={instructorName} // El valor seguirá viniendo de tu estado o prop
                        readOnly // Hace que el campo sea de solo lectura
                        className="w-full px-4 py-2.5 border-2 border-gray-200 bg-gray-50 cursor-not-allowed rounded-xl focus:outline-none text-base font-medium text-gray-800"
                         autoComplete="off"
                        />
                    </div>


                    <p className="text-xs text-gray-500 flex items-center gap-1.5 pt-1">
                      <i className="fas fa-info-circle text-blue-600"></i> Ambos nombres figurarán en tu certificado final.
                    </p>
                  </div>
                  
                  <button 
                    onClick={() => setHasStarted(true)}
                    disabled={!studentName.trim() || !instructorName.trim()}
                    className={`w-full py-3.5 rounded-xl font-bold text-lg transition-all shadow-md flex items-center justify-center gap-2 ${
                      studentName.trim() && instructorName.trim()
                      ? 'bg-blue-600 hover:bg-blue-700 text-white hover:shadow-lg hover:-translate-y-0.5' 
                      : 'bg-gray-100 text-gray-400 cursor-not-allowed'
                    }`}
                  >
                    Comenzar Curso <i className="fas fa-play text-sm ml-1"></i>
                  </button>
                </div>
              </div>
            );
          }

          return (
            <div className="flex h-screen bg-gray-100 font-sans overflow-hidden flex-col md:flex-row selection:bg-blue-200">
              
              {/* NAVBAR MÓVIL */}
              <div className="md:hidden bg-blue-900 text-white p-4 flex justify-between items-center shadow-md z-20">
                <div className="flex items-center gap-2">
                  <i className="fas fa-file-excel text-blue-400 text-2xl"></i>
                  <h1 className="text-lg font-bold">Excel <span className="text-blue-300">Condicional</span></h1>
                </div>
                <button 
                  onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}
                  className="text-white hover:text-blue-300 focus:outline-none p-2"
                >
                  <i className={`fas ${isMobileMenuOpen ? 'fa-times' : 'fa-bars'} text-2xl`}></i>
                </button>
              </div>

              {isMobileMenuOpen && (
                <div 
                  className="fixed inset-0 bg-gray-900/60 z-30 md:hidden transition-opacity" 
                  onClick={() => setIsMobileMenuOpen(false)}
                ></div>
              )}

              {/* SIDEBAR */}
              <div className={`fixed inset-y-0 left-0 w-72 md:w-80 bg-blue-950 text-white flex flex-col shadow-2xl z-40 transform ${isMobileMenuOpen ? "translate-x-0" : "-translate-x-full"} md:relative md:translate-x-0 transition-transform duration-300 ease-in-out`}>
                
                <div className="p-6 flex flex-col items-center gap-4 border-b border-blue-900 bg-blue-900/50 text-center">
                  <div className="w-20 h-20 md:w-24 md:h-24 bg-white rounded-full flex items-center justify-center p-2 shadow-lg overflow-hidden border-4 border-blue-500">
                      <i className="fas fa-file-excel text-blue-700 text-5xl"></i>
                  </div>
                  <div>
                    <h1 className="text-lg md:text-xl font-bold tracking-wide leading-tight">Excel <span className="text-blue-400">Condicional</span></h1>
                    <p className="text-xs text-blue-200 mt-1 uppercase tracking-widest font-medium">Laboratorio Práctico</p>
                  </div>
                </div>
                
                <div className="flex-1 overflow-y-auto py-4 custom-scrollbar">
                  {modules.map((moduleName, modIdx) => (
                    <div key={modIdx} className="mb-6">
                      <h2 className="px-6 text-xs uppercase tracking-widest text-blue-400 font-bold mb-3 mt-2">
                        {moduleName}
                      </h2>
                      <ul className="space-y-1">
                        {courseData.map((l, globalIndex) => {
                          if (l.level !== moduleName) return null; 
                          
                          const isCurrent = globalIndex === currentLessonIndex;
                          const isCompleted = completedLessons.includes(l.id);
                          
                          return (
                            <li key={l.id}>
                              <button
                                onClick={() => goToLesson(globalIndex)}
                                className={`w-full text-left px-5 md:px-6 py-3 flex items-center gap-3 transition-colors ${
                                  isCurrent 
                                    ? 'bg-blue-800 border-l-4 border-blue-400 text-white font-semibold' 
                                    : 'hover:bg-blue-900/50 border-l-4 border-transparent text-blue-100 hover:text-white'
                                }`}
                              >
                                {isCompleted ? (
                                  <i className="fas fa-check-circle text-blue-400 text-lg flex-shrink-0 drop-shadow"></i>
                                ) : (
                                  <div className={`w-[18px] h-[18px] rounded-full border-2 flex-shrink-0 ${isCurrent ? 'border-blue-400' : 'border-blue-700'}`} />
                                )}
                                <span className="text-sm pr-2 leading-tight">{l.title}</span>
                              </button>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  ))}
                </div>
                
                <div className="p-5 border-t border-blue-900 bg-blue-950">
                  <div className="flex items-center justify-between mb-2">
                    <span className="text-xs text-blue-300 uppercase tracking-widest font-bold">Tu Progreso</span>
                    <span className="text-sm font-bold text-blue-400">{completedLessons.length} / {courseData.length}</span>
                  </div>
                  <div className="w-full bg-blue-900 rounded-full h-2 mb-4 overflow-hidden shadow-inner">
                    <div 
                      className="bg-blue-400 h-2 rounded-full transition-all duration-500 relative" 
                      style={{ width: `${(completedLessons.length / courseData.length) * 100}%` }}
                    >
                        <div className="absolute top-0 left-0 right-0 bottom-0 bg-white/20"></div>
                    </div>
                  </div>

                  <div className="text-center text-xs text-blue-300/80 border-t border-blue-900/80 pt-3">
                    Instructor: <strong className="text-white font-semibold">{instructorName}</strong>
                  </div>
                </div>
              </div>

              {/* ÁREA DE CONTENIDO PRINCIPAL */}
              <div className="flex-1 flex flex-col overflow-y-auto relative z-10 w-full bg-white md:bg-gray-50">
                <div className="max-w-5xl mx-auto w-full flex-1 flex flex-col p-4 md:p-8">
                  
                  <header className="mb-4 md:mb-6">
                    <div className="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3 border border-blue-200">
                        {lesson.level}
                    </div>
                    <h2 className="text-2xl md:text-3xl font-extrabold text-gray-800 mb-4 md:mb-6 tracking-tight">{lesson.title}</h2>
                    
                    <div className="flex border-b-2 border-gray-200">
                      <button 
                        onClick={() => setViewMode('theory')}
                        className={`flex-1 md:flex-none px-3 md:px-8 py-3 font-bold text-sm md:text-base rounded-t-lg transition-all flex justify-center items-center gap-2 ${
                          viewMode === 'theory' 
                          ? 'bg-white border-2 border-b-0 border-gray-200 text-blue-700 shadow-[0_4px_0_0_white]' 
                          : 'text-gray-500 hover:text-gray-700 hover:bg-gray-100 border-2 border-transparent border-b-0'
                        }`}
                        style={{ marginBottom: '-2px' }}
                      >
                        <i className="fas fa-book-open"></i> <span className="hidden sm:inline">Lectura Teórica</span><span className="sm:hidden">Teoría</span>
                      </button>
                      <button 
                        onClick={() => setViewMode('practice')}
                        className={`flex-1 md:flex-none px-3 md:px-8 py-3 font-bold text-sm md:text-base rounded-t-lg transition-all flex justify-center items-center gap-2 ${
                          viewMode === 'practice' 
                          ? 'bg-white border-2 border-b-0 border-gray-200 text-blue-700 shadow-[0_4px_0_0_white]' 
                          : 'text-gray-500 hover:text-gray-700 hover:bg-gray-100 border-2 border-transparent border-b-0'
                        }`}
                        style={{ marginBottom: '-2px' }}
                      >
                        <i className="fas fa-table"></i> <span className="hidden sm:inline">Práctica en Hoja</span><span className="sm:hidden">Práctica</span>
                      </button>
                    </div>
                  </header>

                  {/* TEORÍA */}
                  {viewMode === 'theory' && (
                    <div className="bg-white border-2 border-gray-200 rounded-b-xl rounded-tr-xl p-5 md:p-8 shadow-sm flex-1">
                      <div className="max-w-3xl">
                        {renderTheoryContent()}
                        
                        <div className="mt-8 pt-6 border-t border-gray-200 text-center md:text-left">
                          <button 
                            onClick={() => setViewMode('practice')}
                            className="bg-blue-600 hover:bg-blue-700 text-white text-base md:text-lg px-6 md:px-8 py-3 rounded-xl font-bold transition-all shadow-md hover:shadow-lg inline-flex items-center gap-3 w-full justify-center md:w-auto"
                          >
                            Hacer Ejercicio Práctico <i className="fas fa-chevron-right text-sm"></i>
                          </button>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* PRÁCTICA */}
                  {viewMode === 'practice' && (
                    <div className="flex-1 flex flex-col">
                      
                      <div className="flex justify-between items-center mb-3 text-sm font-bold text-gray-500 uppercase tracking-wider">
                        <span>Hoja de Cálculo Activa</span>
                        <span className="bg-gray-200 text-gray-700 px-3 py-1 rounded-full border border-gray-300">
                          Ejercicio {currentExerciseIndex + 1} de {lesson.exercises.length}
                        </span>
                      </div>

                      <div className="bg-white border-l-4 border-blue-600 p-4 md:p-5 rounded-lg mb-4 md:mb-6 shadow-sm ring-1 ring-gray-200">
                        <p className="text-gray-800 text-base md:text-lg">
                          <i className="fas fa-check-circle text-blue-600 mr-2"></i>
                          <strong>Instrucción:</strong> {exercise.instruction}
                        </p>
                      </div>

                      <div className="bg-white rounded-xl shadow-lg border border-gray-300 overflow-hidden mb-6 md:mb-8">
                        {/* BARRA DE FÓRMULAS ESTILO EXCEL */}
                        <div className="bg-[#f3f2f1] border-b border-[#cccccc] p-2 md:px-4 md:py-2 flex flex-col md:flex-row md:items-center gap-2 md:gap-4 text-sm font-sans">
                          
                          <div className="flex items-center text-gray-700 font-sans w-auto md:w-20 bg-white px-2 py-1 border border-[#cccccc] shadow-inner text-center justify-center">
                            <span className="font-semibold">{exercise.targetCell}</span>
                          </div>
                          
                          <div className="flex-1 flex items-center bg-white border border-[#cccccc] shadow-inner overflow-hidden focus-within:border-blue-600 focus-within:ring-1 focus-within:ring-blue-600 transition-all">
                            <div className="px-3 text-gray-500 bg-[#f3f2f1] border-r border-[#cccccc] italic font-serif py-1 font-bold text-sm md:text-base flex items-center">fx</div>
                            <input
                              type="text"
                              value={userInput}
                              onChange={(e) => setUserInput(e.target.value)}
                              onKeyDown={(e) => e.key === 'Enter' && handleCheck()}
                              className="flex-1 px-2 md:px-3 py-1 md:py-1.5 outline-none font-mono text-gray-800 placeholder-gray-300 text-base md:text-lg w-full min-w-0"
                              placeholder="Escribe la fórmula aquí..."
                              autoComplete="off"
                              spellCheck="false"
                              disabled={feedback === 'success'} 
                            />
                          </div>
                          
                          <button 
                            onClick={handleCheck}
                            className={`${feedback === 'success' ? 'bg-gray-400 cursor-not-allowed' : 'bg-blue-700 hover:bg-blue-800 active:bg-blue-900'} text-white w-full md:w-auto px-6 py-2 rounded font-semibold transition-colors shadow-sm flex justify-center items-center gap-2 text-sm`}
                            disabled={feedback === 'success'}
                          >
                            <i className="fas fa-check"></i> Validar
                          </button>
                        </div>

                        {/* CUADRÍCULA ESTILO EXCEL */}
                        <div className="overflow-x-auto bg-white touch-pan-x">
                          <table className="w-full border-collapse min-w-[500px] md:min-w-full font-sans text-sm md:text-base">
                            <thead>
                              <tr>
                                <th className="border border-[#cccccc] bg-[#e6e6e6] w-8 md:w-12 h-6 md:h-8"></th> 
                                {exercise.grid[0].cols.map((_, colIdx) => (
                                  <th key={colIdx} className="border border-[#cccccc] bg-[#e6e6e6] text-[#333333] font-normal py-1 px-2 min-w-[90px] md:min-w-[120px] text-center select-none">
                                    {getColumnLetter(colIdx)}
                                  </th>
                                ))}
                              </tr>
                            </thead>
                            <tbody>
                              {exercise.grid.map((rowData, rowIdx) => (
                                <tr key={rowIdx}>
                                  <td className="border border-[#cccccc] bg-[#e6e6e6] text-[#333333] text-center font-normal py-1 md:py-2 select-none">
                                    {rowData.row}
                                  </td>
                                  {rowData.cols.map((cellValue, colIdx) => {
                                    const cellId = `${getColumnLetter(colIdx)}${rowData.row}`;
                                    const isTarget = cellId === exercise.targetCell;
                                    
                                    return (
                                      <td 
                                        key={colIdx} 
                                        className={`border border-[#cccccc] px-2 md:px-3 py-1 md:py-2 text-gray-800 relative
                                          ${isTarget && feedback !== 'success' ? 'bg-white ring-2 ring-blue-600 outline-none z-10 shadow-[0_0_0_4px_rgba(37,99,235,0.2)]' : 'bg-white'}
                                          ${isTarget && feedback === 'success' ? 'bg-blue-50' : ''}
                                        `}
                                      >
                                        {isTarget ? (
                                          <span className={`block font-mono ${feedback === 'success' ? 'font-bold text-gray-900 text-right' : 'text-gray-300'}`}>
                                            {feedback === 'success' ? exercise.resultValue : ' '}
                                          </span>
                                        ) : (
                                          <span className={`block ${(cellValue && !isNaN(cellValue)) || cellValue.includes('$') || cellValue.includes('%') ? 'text-right' : 'text-left'}`}>
                                            {cellValue}
                                          </span>
                                        )}
                                        
                                        {isTarget && feedback !== 'success' && (
                                            <div className="absolute bottom-[-4px] right-[-4px] w-2 h-2 bg-blue-700 border border-white z-20 cursor-crosshair"></div>
                                        )}
                                      </td>
                                    );
                                  })}
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </div>

                      {/* FEEDBACK */}
                      <div className="min-h-[7rem] md:h-28 mb-4">
                        {feedback === 'empty' && (
                          <div className="p-3 md:p-4 bg-orange-50 text-orange-800 rounded-lg border border-orange-200 flex items-center gap-3 shadow-sm text-sm md:text-base">
                            <i className="fas fa-exclamation-triangle text-xl text-orange-600 flex-shrink-0"></i>
                            <p>Escribe una fórmula en la barra de arriba antes de validar.</p>
                          </div>
                        )}
                        
                        {feedback === 'error' && (
                          <div className="p-3 md:p-4 bg-red-50 text-red-800 rounded-lg border border-red-200 flex items-start gap-3 shadow-sm text-sm md:text-base">
                            <i className="fas fa-times-circle text-xl text-red-600 mt-0.5 flex-shrink-0"></i>
                            <div>
                              <p className="font-bold mb-1">¡Resultado Incorrecto!</p>
                              <p className="text-sm">Por favor verifica la sintaxis. <strong>Pista:</strong> {exercise.tip}</p>
                            </div>
                          </div>
                        )}

                        {feedback === 'success' && (
                          <div className="p-4 md:p-5 bg-blue-50 text-blue-900 rounded-xl border border-blue-200 flex flex-col sm:flex-row items-center justify-between shadow-sm border-l-4 border-l-blue-600 gap-4 text-center sm:text-left">
                            <div className="flex items-center gap-3 md:gap-4 flex-col sm:flex-row">
                              <i className="fas fa-check-circle text-3xl text-blue-600 flex-shrink-0"></i>
                              <div>
                                <p className="font-bold text-lg md:text-xl">¡Cálculo Exitoso!</p>
                                <p className="text-blue-700 text-sm md:text-base">La fórmula arrojó el resultado: <strong>{exercise.resultValue}</strong>.</p>
                              </div>
                            </div>
                            
                            <div className="w-full sm:w-auto">
                              {currentExerciseIndex < lesson.exercises.length - 1 ? (
                                <button 
                                  onClick={handleNextExercise}
                                  className="w-full sm:w-auto flex items-center justify-center gap-2 bg-blue-700 hover:bg-blue-800 text-white px-6 py-3 rounded-lg font-bold transition-all shadow-md text-sm md:text-base"
                                >
                                  Siguiente Ejercicio <i className="fas fa-chevron-right text-xs"></i>
                                </button>
                              ) : completedLessons.length === courseData.length ? (
                                <button 
                                  onClick={() => setShowCompletionModal(true)}
                                  className="w-full sm:w-auto px-6 py-3 bg-yellow-400 hover:bg-yellow-500 transition-colors text-yellow-900 rounded-lg font-extrabold shadow-md text-sm md:text-base animate-pulse"
                                >
                                  ¡Ver mi Certificado! 🎉
                                </button>
                              ) : currentLessonIndex < courseData.length - 1 ? (
                                <button 
                                  onClick={handleNextLesson}
                                  className="w-full sm:w-auto flex items-center justify-center gap-2 bg-blue-700 hover:bg-blue-800 text-white px-6 py-3 rounded-lg font-bold transition-all shadow-md text-sm md:text-base"
                                >
                                  Siguiente Tema <i className="fas fa-chevron-right text-xs"></i>
                                </button>
                              ) : (
                                <button 
                                  onClick={() => {
                                    const missingIndex = courseData.findIndex(l => !completedLessons.includes(l.id));
                                    if (missingIndex !== -1) goToLesson(missingIndex);
                                  }}
                                  className="w-full sm:w-auto flex items-center justify-center gap-2 bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-bold transition-all shadow-md text-sm md:text-base"
                                >
                                  Temas Pendientes <i className="fas fa-undo text-xs"></i>
                                </button>
                              )}
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  )}

                </div>
              </div>

              {/* MODAL DE CERTIFICADO */}
              {showCompletionModal && (
                <div className="fixed inset-0 bg-gray-900/90 backdrop-blur-sm flex items-center justify-center z-50 p-4">
                  <div className="bg-gray-100 rounded-2xl shadow-2xl p-4 md:p-6 max-w-4xl w-full flex flex-col items-center border-t-8 border-blue-600">
                    
                    <div className="w-full overflow-x-auto pb-4 custom-scrollbar">
                      <div id="certificate" className="bg-white mx-auto relative overflow-hidden shadow-xl" style={{ width: '800px', height: '550px' }}>
                        <div className="absolute inset-0 border-[16px] border-[#1d4ed8]"></div>
                        <div className="absolute inset-4 border-[4px] border-blue-700"></div>
                        
                        <div className="absolute inset-8 p-8 flex flex-col items-center text-center bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-blue-50 via-white to-white">
                          
                          <div className="w-20 h-20 bg-white rounded-full flex items-center justify-center mb-3 border-2 border-blue-200 shadow-sm z-10">
                            <i className="fas fa-file-excel text-[#1d4ed8] text-4xl"></i>
                          </div>
                          
                          <h2 className="text-3xl font-serif font-bold text-gray-800 mb-1 uppercase tracking-widest border-b-2 border-blue-700 pb-2">
                            Certificado de Finalización
                          </h2>
                          
                          <p className="text-base text-gray-500 mb-4 italic mt-2">
                            Otorgado orgullosamente a:
                          </p>
                          
                          <h1 className="text-4xl font-bold text-blue-900 mb-5 capitalize" style={{ fontFamily: 'Georgia, serif' }}>
                            {studentName}
                          </h1>
                          
                          <p className="text-base text-gray-600 mb-8 max-w-lg leading-relaxed">
                            Por haber completado satisfactoriamente el laboratorio práctico y dominar el uso de <strong>Fórmulas Condicionales (CONTAR.SI, SUMAR.SI, PROMEDIO.SI, MAX/MIN.SI)</strong>.
                          </p>
                          
                          <div className="flex justify-between w-full px-12 mt-auto">
                            <div className="text-center">
                              <p className="text-base font-bold text-gray-800 border-b border-gray-400 pb-1 px-4 mb-1">
                                {new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
                              </p>
                              <p className="text-xs text-gray-500 uppercase tracking-widest font-semibold">Fecha de Emisión</p>
                            </div>
                            
                            <div className="text-center">
                              <div className="w-56 border-b border-gray-400 pb-1 mb-1">
                                <span className="font-serif italic text-2xl text-gray-800 capitalize" style={{ fontFamily: 'Georgia, serif' }}>
                                  {instructorName}
                                </span>
                              </div>
                              <p className="text-xs text-gray-500 uppercase tracking-widest font-semibold">Instructor Autorizado</p>
                            </div>
                          </div>
                          
                          <i className="fas fa-award absolute text-blue-900/5 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 -z-10 text-[260px]"></i>
                        </div>
                      </div>
                    </div>

                    <div className="flex flex-col sm:flex-row gap-4 mt-4 w-full justify-center">
                      <button 
                        onClick={downloadCertificate}
                        className="bg-blue-700 hover:bg-blue-800 text-white font-bold text-base py-3 px-8 rounded-full transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2"
                      >
                        <i className="fas fa-download"></i> Guardar Certificado como Imagen
                      </button>
                      <button 
                        onClick={() => setShowCompletionModal(false)}
                        className="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold text-base py-3 px-8 rounded-full transition-all shadow-md flex items-center justify-center"
                      >
                        Cerrar
                      </button>
                    </div>
                  </div>
                </div>
              )}

            </div>
          );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
    
    <style>
      .custom-scrollbar::-webkit-scrollbar { width: 6px; }
      .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
      .custom-scrollbar::-webkit-scrollbar-thumb { background-color: rgba(255, 255, 255, 0.2); border-radius: 10px; }
      
      .touch-pan-x { -ms-overflow-style: none; scrollbar-width: none; }
      .touch-pan-x::-webkit-scrollbar { display: none; }
    </style>
</body>
</html>
